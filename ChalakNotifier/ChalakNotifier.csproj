<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.0 → Windows XP SP3, Vista, 7, 8, 8.1, 10, 11
    (ویندوز 8 به بعد 4.x را دارند؛ روی XP/7 در صورت نبود، 4.0 نصب شود)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net40</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ChalakNotifier</AssemblyName>
    <RootNamespace>ChalakNotifier</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- امکان build با dotnet CLI بدون نصب Targeting Pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <None Update="notifier.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="app.config" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
